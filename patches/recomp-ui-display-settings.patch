+// Render thread / Present thread / Smooth motion rows for the deep (PSX-style)
+// Display card. The legacy card below draws the same three inline; without
+// this the deep card had no way to reach them, so a PSX title's frame
+// generation could only be switched by editing settings.toml.
+static void draw_render_pipeline_rows(LauncherModel* m, const LauncherTheme& th) {
+    if (!launcher_model_render_pipeline_offered(m)) return;
+    row_label_right("Render thread", th, px(SETTINGS_CTRL_W));
+    bool rt = m->s.render_thread != 0;
+    if (ImGui::Checkbox("##render_thread_deep", &rt))
+        m->s.render_thread = rt ? 1 : 0;
+    if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal))
+        ImGui::SetTooltip("Draws on a separate thread so the game keeps running while a frame renders.\n"
+                          "Turn off if you see stutter or glitches. Applies at next launch.");
+    const bool kids = launcher_model_render_pipeline_children_enabled(m);
+    ImGui::BeginDisabled(!kids);
+    row_label_right("Present thread", th, px(SETTINGS_CTRL_W));
+    bool pt = m->s.present_thread != 0;
+    if (ImGui::Checkbox("##present_thread_deep", &pt))
+        m->s.present_thread = pt ? 1 : 0;
+    if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+        ImGui::SetTooltip("Shows finished frames from another thread so waiting for the display never stalls drawing.\n"
+                          "Needs Render thread. Applies at next launch.");
+    // TwistedMetal1234Recomp: frame generation only holds up on Twisted Metal 4.
+    row_label_right("Smooth Motion (Twisted Metal 4 only)", th, px(SETTINGS_CTRL_W));
+    bool fg = m->s.frame_generation != 0;
+    if (ImGui::Checkbox("##frame_generation_deep", &fg))
+        m->s.frame_generation = fg ? 1 : 0;
+    if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+        ImGui::SetTooltip("Adds extra in-between frames up to your display's refresh rate, made from the camera.\n"
+                          "Adds up to one frame of delay. Needs Render thread. Applies at next launch.\n"
+                          "Only use with Twisted Metal 4: the other games reject nearly every in-between frame.");
+    ImGui::EndDisabled();
+}
+
+// TwistedMetal1234Recomp: the frame rate cap of Twisted Metal 1 and 2, which
+// the host turns into those games' frame rate patches at launch.
+static void draw_fps_mode_row(LauncherModel* m, const LauncherTheme& th) {
+    if (!m->has_fps_mode) return;
+    static const char* kModes[3] = { "Normal", "30", "60" };
+    row_label_right("FPS Mode (Twisted Metal 1 and 2 only)", th, px(SETTINGS_CTRL_W));
+    int mode = m->s.fps_mode;
+    if (mode < 0 || mode > 2) mode = 0;
+    ImGui::PushID("fps_mode");
+    ImGui::SetNextItemWidth(px(SETTINGS_CTRL_W));
+    if (ImGui::BeginCombo("##fps_mode", kModes[mode])) {
+        for (int i = 0; i < 3; ++i)
+            if (ImGui::Selectable(kModes[i], mode == i))
+                m->s.fps_mode = i;
+        ImGui::EndCombo();
+    }
+    if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal))
+        ImGui::SetTooltip("Normal is the original 20 frames per second.\n"
+                          "30 plays closest to the original; 60 is smoother but handling feels off.\n"
+                          "Applies at next launch.");
+    ImGui::PopID();
+}
